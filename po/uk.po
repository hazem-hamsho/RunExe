#. Translators: Luma is not translatable
#: runexe/frontend/ui/dialog-vkbasalt.blp:99
msgid "Denoised Luma Sharpening"
msgstr "Різкість Luma зі зменшенням шуму"

#: runexe/frontend/ui/dialog-vkbasalt.blp:130
msgid "Denoise"
msgstr "Зменшення шуму"

#: runexe/frontend/ui/dialog-vkbasalt.blp:160
msgid "Fast Approximate Anti-Aliasing"
msgstr "Швидке приблизне згладжування (FXAA)"

#: runexe/frontend/ui/dialog-vkbasalt.blp:163
msgid "Subpixel Quality"
