msgstr "חידוד לומה מופחת רעשים"

#: runexe/frontend/ui/dialog-vkbasalt.blp:130
msgid "Denoise"
msgstr "הפחתת רעשים"

#: runexe/frontend/ui/dialog-vkbasalt.blp:160
msgid "Fast Approximate Anti-Aliasing"
msgstr "החלקת קצוות משוערות מהירה (FXAA)"

#: runexe/frontend/ui/dialog-vkbasalt.blp:163
msgid "Subpixel Quality"
msgstr "איכות תת־פיקסל"

#: runexe/frontend/ui/dialog-vkbasalt.blp:191
