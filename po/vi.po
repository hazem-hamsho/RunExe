msgstr ""
"Khắc phục sự cố khi chương trình đóng sau khi được khởi chạy từ "
"\"Chạy tệp thực thi\""

#: data/io.github.runexe.RunExe.metainfo.xml.in:159
msgid "and many, many, many more!"
msgstr "và nhiều, rất nhiều, nhiều hơn nữa!"
